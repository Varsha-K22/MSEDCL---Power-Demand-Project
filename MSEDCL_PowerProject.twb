        <calculation class='tableau' formula='IF MONTH([Date]) IN (3,4,5,6)&#13;&#10;THEN &quot;Summer&quot;&#13;&#10;ELSEIF MONTH([Date]) IN (7,8,9)&#13;&#10;THEN &quot;Monsoon&quot;&#13;&#10;ELSE &quot;Winter&quot;&#13;&#10;END' />
