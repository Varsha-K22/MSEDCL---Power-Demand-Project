      <table>
        <view>
          <datasources>
            <datasource caption='MSEDCLpd_sql' name='federated.01ugzb81teuozi18h2l0z02oniyp' />
          </datasources>
          <datasource-dependencies datasource='federated.01ugzb81teuozi18h2l0z02oniyp'>
            <column caption='Peak Demand Date' datatype='date' name='[Calculation_1250432816594946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN(&#13;&#10;    IF [Maximum_Peak_of_Day] = { FIXED : MAX([Maximum_Peak_of_Day]) }&#13;&#10;THEN [Date]&#13;&#10;END&#13;&#10;)' />
            </column>
            <column caption='Day Type Filter' datatype='string' name='[Calculation_1250432834150405]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEPART(&apos;weekday&apos;,[Date]) IN (1,7)&#13;&#10;THEN &quot;Weekend&quot;&#13;&#10;ELSE &quot;Weekday&quot;&#13;&#10;END' />
            </column>
            <column datatype='date' name='[Date]' role='dimension' type='ordinal' />
            <column caption='Maximum Peak of Day' datatype='integer' name='[Maximum_Peak_of_Day]' role='dimension' type='quantitative' />
            <column-instance column='[Date]' derivation='Month' name='[mn:Date:ok]' pivot='key' type='ordinal' />
