      <aliases enabled='yes' />
      <column caption='Max Peak Day' datatype='integer' name='[Calculation_1250432815050753]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([Maximum_Peak_of_Day])' />
      </column>
      <column caption='Peak Demand Date' datatype='date' name='[Calculation_1250432816594946]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(&#13;&#10;    IF [Maximum_Peak_of_Day] = { FIXED : MAX([Maximum_Peak_of_Day]) }&#13;&#10;THEN [Date]&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='Total Days of Analyzed' datatype='integer' name='[Calculation_1250432818139139]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Date])' />
      </column>
      <column caption='Season Filter' datatype='string' name='[Calculation_1250432833712132]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF MONTH([Date]) IN (3,4,5,6)&#13;&#10;THEN &quot;Summer&quot;&#13;&#10;ELSEIF MONTH([Date]) IN (7,8,9)&#13;&#10;THEN &quot;Monsoon&quot;&#13;&#10;ELSE &quot;Winter&quot;&#13;&#10;END' />
      </column>
      <column caption='Day Type Filter' datatype='string' name='[Calculation_1250432834150405]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEPART(&apos;weekday&apos;,[Date]) IN (1,7)&#13;&#10;THEN &quot;Weekend&quot;&#13;&#10;ELSE &quot;Weekday&quot;&#13;&#10;END' />
      </column>
      <column caption='Month-Year' datatype='datetime' name='[Calculation_1460714758213632]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[Date])' />
      </column>
